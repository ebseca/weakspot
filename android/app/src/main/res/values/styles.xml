<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the app while it starts. Dark regardless of the
         system light/dark setting, because the app itself is. Without this
         a cold start flashes white before Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- The window behind the running app, seen during transitions. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
