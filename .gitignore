# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code per-machine settings (launch.json is shared, this is not)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Signing material. NEVER commit any of this.
#
# The upload key is the app's permanent identity on Google Play: anyone holding
# it can publish updates as you, and losing it means you cannot update the app
# at all. The real key lives in C:\bigideas\vault\flashcards, outside the repo;
# these rules are the second line of defence.
# ---------------------------------------------------------------------------
key.properties
**/key.properties
*.jks
*.keystore
*.p12
**/*.jks
**/*.keystore
**/*.p12

# Local secrets and environment files
*.env
.env.local

# Build outputs that sometimes escape /build/
*.apk
*.aab
